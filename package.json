{
  "name": "@synmux/aicmd",
  "version": "0.1.0",
  "description": "Generate shell commands from natural language with Claude. Uses your Claude Code subscription.",
  "type": "module",
  "private": false,
  "bin": {
    "aicmd": "bin/aicmd.js",
    "ai": "bin/aicmd.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "index.ts"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.263",
    "@anthropic-ai/sdk": "^0.117.1",
    "@biomejs/biome": "^2.5.12",
    "@trunkio/launcher": "^1.3.4",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "skilld": "^2.3.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@emnapi/core": "2.0.0-alpha.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@clack/core": "^1.4.3",
    "@clack/prompts": "^1.7.0",
    "@opentui/core": "^0.5.10",
    "cli-spinners": "^3.4.0",
    "commander": "^15.0.0",
    "ora": "^9.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synmux/aicmd"
  },
  "scripts": {
    "start": "node bin/aicmd.ts",
    "build": "esbuild bin/aicmd.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/aicmd.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "prepare": "skilld prepare || true"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
