{
  "name": "@synmux/aicmd",
  "version": "0.1.0",
  "description": "Generate shell commands from natural language with Claude — show, confirm, and run them safely. Uses your Claude Code subscription.",
  "type": "module",
  "private": false,
  "bin": {
    "aicmd": "bin/aicmd.js",
    "ai": "bin/aicmd.js"
  },
  "exports": {
    ".": {
      "bun": "./index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "index.ts"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.235",
    "@anthropic-ai/sdk": "^0.117.1",
    "@biomejs/biome": "^2.5.9",
    "@trunkio/launcher": "^1.3.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "skilld": "^2.3.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@emnapi/core": "2.0.0-alpha.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.235",
    "@opentui/core": "^0.5.4",
    "cli-spinners": "^3.4.0",
    "commander": "^15.0.0",
    "ora": "^9.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synmux/aicmd"
  },
  "scripts": {
    "start": "bun run bin/aicmd.ts",
    "build": "bun build bin/aicmd.ts --outfile=dist/aicmd.js --target=node --packages=external",
    "test": "bun test",
    "format": "bun run prettier --write .",
    "typecheck": "bun run tsc --noEmit",
    "prepack": "bun run build",
    "prepare": "skilld prepare || true"
  },
  "trustedDependencies": [
    "@anthropic-ai/claude-code",
    "@google/genai",
    "onnxruntime-node",
    "protobufjs",
    "sharp"
  ]
}
